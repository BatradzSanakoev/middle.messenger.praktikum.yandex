{
  "name": "middle.messenger.praktikum.yandex",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run build && vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "stylelint \"src/**/*.css\" && eslint . && prettier --check . && npm run typecheck",
    "lint:fix": "eslint --fix . && prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*": [
      "prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@poliklot/prettier-plugin-handlebars": "^0.4.1",
    "@types/handlebars": "^4.0.40",
    "@types/node": "^26.6.2",
    "@vitest/ui": "^5.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "postcss": "^8.5.28",
    "postcss-import": "^17.0.0",
    "postcss-modules": "^9.0.1",
    "postcss-nested": "^8.0.1",
    "postcss-preset-env": "^11.5.4",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vite-plugin-checker": "^1.0.0",
    "vite-plugin-handlebars": "^2.0.3",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "dotenv": "^18.0.3",
    "handlebars": "^4.7.9"
  }
}
