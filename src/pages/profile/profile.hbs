<div class="{{ styles.profilePage }}">

  <!-- Блок 1: Аватар -->
  <div class="{{ styles.profileHeader }}">
    {{{ProfileAvatar ref="avatar" avatarUrl="https://placehold.co/128/grey/grey/png"}}}
    <h1 class="{{ styles.profileName }}">Иван Иванов</h1>
  </div>

  <!-- Форма 1: Данные пользователя -->
  <form class="{{ styles.profileForm }}" data-role="profile-form-data">
    <div class="{{ styles.profileData }}" data-role="profile-data">
      <div class="{{ styles.dataRow }}" data-role="profile-data">
        <label class="{{ styles.dataLabel }}" for="email">Почта:</label>
        <div class="{{ styles.inputWrapper }}">
          {{{Input ref="emailInput" type="email" name="email" id="email" value="user@example.com" disabled=true validationKey="email"}}}
        </div>
      </div>
      <div class="{{ styles.dataRow }}" data-role="profile-data">
        <label class="{{ styles.dataLabel }}" for="login">Логин:</label>
        <div class="{{ styles.inputWrapper }}">
          {{{Input ref="loginInput" type="text" name="login" id="login" value="username123" disabled=true validationKey="login"}}}
        </div>
      </div>
      <div class="{{ styles.dataRow }}" data-role="profile-data">
        <label class="{{ styles.dataLabel }}" for="first_name">Имя:</label>
        <div class="{{ styles.inputWrapper }}">
          {{{Input ref="firstNameInput" type="text" name="first_name" id="first_name" value="Иван" disabled=true validationKey="first_name"}}}
        </div>
      </div>
      <div class="{{ styles.dataRow }}" data-role="profile-data">
        <label class="{{ styles.dataLabel }}" for="second_name">Фамилия:</label>
        <div class="{{ styles.inputWrapper }}">
          {{{Input ref="secondNameInput" type="text" name="second_name" id="second_name" value="Иванов" disabled=true validationKey="second_name"}}}
        </div>
      </div>
      <div class="{{ styles.dataRow }}" data-role="profile-data">
        <label class="{{ styles.dataLabel }}" for="display_name">Имя в чате:</label>
        <div class="{{ styles.inputWrapper }}">
          {{{Input ref="displayNameInput" type="text" name="display_name" id="display_name" value="ivan_cool" disabled=true validationKey="display_name"}}}
        </div>
      </div>
      <div class="{{ styles.dataRow }}" data-role="profile-data">
        <label class="{{ styles.dataLabel }}" for="phone">Телефон:</label>
        <div class="{{ styles.inputWrapper }}">
          {{{Input ref="phoneInput" type="tel" name="phone" id="phone" value="+7 (999) 123-45-67" disabled=true validationKey="phone"}}}
        </div>
      </div>
    </div>

    <!-- Кнопки управления -->
    <div class="{{ styles.profileActions }}" data-role="profile-actions-normal">
      {{{Button ref="editDataBtn" text="Изменить данные" dataRole="btn-edit-data"}}}
      {{{Button ref="editPasswordBtn" text="Изменить пароль" dataRole="btn-edit-password"}}}
      {{{Button ref="logoutBtn" text="Выйти" dataRole="btn-logout"}}}
    </div>

    <!-- Кнопка сохранения данных (скрыта) -->
    <div class="{{ styles.profileActions }} {{ styles.hidden }}" data-role="profile-actions-save-data">
      {{{Button ref="saveDataBtn" text="Сохранить" dataRole="save-data"}}}
    </div>
  </form>

