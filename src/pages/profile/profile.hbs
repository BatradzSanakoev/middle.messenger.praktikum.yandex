<form
  class="{{ styles.profilePage }} {{ styles.profileForm }}"
  action="#"
  onsubmit="event.preventDefault()"
>

  <!-- Блок 1: Аватар -->
  <div class="{{ styles.profileHeader }}">
    {{{ProfileAvatar avatarUrl="https://placehold.co/128/grey/grey/png"}}}
    <h1 class="{{ styles.profileName }}">Иван Иванов</h1>
  </div>

  <!-- Блок 2: Данные пользователя -->
  <div class="{{ styles.profileData }}" data-role="profile-data">
    <div class="{{ styles.dataRow }}">
      <label class="{{ styles.dataLabel }}" for="email">Почта:</label>
      {{{Input type="email" name="email" id="email" value="user@example.com" disabled=true}}}
    </div>
    <div class="{{ styles.dataRow }}">
      <label class="{{ styles.dataLabel }}" for="login">Логин:</label>
      {{{Input type="text" name="login" id="login" value="username123" disabled=true}}}
    </div>
    <div class="{{ styles.dataRow }}">
      <label class="{{ styles.dataLabel }}" for="first_name">Имя:</label>
      {{{Input type="text" name="first_name" id="first_name" value="Иван" disabled=true}}}
    </div>
    <div class="{{ styles.dataRow }}">
      <label class="{{ styles.dataLabel }}" for="second_name">Фамилия:</label>
      {{{Input type="text" name="second_name" id="second_name" value="Иванов" disabled=true}}}
    </div>
    <div class="{{ styles.dataRow }}">
      <label class="{{ styles.dataLabel }}" for="display_name">Имя в чате:</label>
      {{{Input type="text" name="display_name" id="display_name" value="ivan_cool" disabled=true}}}
    </div>
    <div class="{{ styles.dataRow }}">
      <label class="{{ styles.dataLabel }}" for="phone">Телефон:</label>
      {{{Input type="tel" name="phone" id="phone" value="+7 (999) 123-45-67" disabled=true}}}
    </div>
  </div>

  <!-- Блок 3: Режим изменения пароля (скрыт) -->
  <div class="{{ styles.profileData }} {{ styles.hidden }}" data-role="profile-data-password">
    <div class="{{ styles.dataRow }}">
      <label class="{{ styles.dataLabel }}" for="old_password">Старый пароль:</label>
      {{{Input type="password" name="old_password" id="old_password" value="••••••"}}}
    </div>
    <div class="{{ styles.dataRow }}">
      <label class="{{ styles.dataLabel }}" for="new_password">Новый пароль:</label>
      {{{Input type="password" name="new_password" id="new_password" value="••••••"}}}
    </div>
    <div class="{{ styles.dataRow }}">
      <label class="{{ styles.dataLabel }}" for="confirm_password">Повторите новый пароль:</label>
      {{{Input type="password" name="confirm_password" id="confirm_password" value="••••••"}}}
    </div>
  </div>

  <!-- Блок 4: Обычные кнопки -->
  <div class="{{ styles.profileActions }}" data-role="profile-actions-normal">
    {{{Button text="Изменить данные" dataRole="btn-edit-data"}}}
    {{{Button text="Изменить пароль" dataRole="btn-edit-password"}}}
    {{{Button text="Выйти" dataRole="btn-logout"}}}
  </div>

  <!-- Блок 5: Кнопка сохранения (скрыта) -->
  <div class="{{ styles.profileActions }} {{ styles.hidden }}" data-role="profile-actions-save">
    {{{Button text="Сохранить" dataRole="btn-save"}}}
  </div>

</form>
