<form class="{{ styles.form }}">
  <h1 class="{{ styles.title }}">Вход</h1>
  <div class="{{ styles.fields }}">
    {{{Input ref="loginInput" name="login" placeholder="Логин" validationKey="login" required=true}}}
    {{{Input ref="passwordInput" name="password" placeholder="Пароль" type="password" validationKey="password" required=true}}}
  </div>
  <div class="{{ styles.actions }}">
    {{{Button ref="submitBtn" text="Войти" type="submit"}}}
    {{{Link ref="registerLink" href="#" text="Зарегистрироваться"}}}
  </div>
</form>
