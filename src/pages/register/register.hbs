<form class="{{ styles.form }}">
  <h1 class="{{ styles.title }}">Регистрация</h1>
  <div class="{{ styles.fields }}">
    {{{Input ref="firstNameInput" name="first_name" placeholder="Имя" validationKey="first_name" required=true}}}
    {{{Input ref="secondNameInput" name="second_name" placeholder="Фамилия" validationKey="second_name" required=true}}}
    {{{Input ref="loginInput" name="login" placeholder="Логин" validationKey="login" required=true}}}
    {{{Input ref="emailInput" name="email" placeholder="Email" validationKey="email" required=true}}}
    {{{Input ref="passwordInput" name="password" placeholder="Пароль" type="password" validationKey="password" required=true}}}
    {{{Input ref="phoneInput" name="phone" placeholder="Телефон" validationKey="phone" required=true}}}
  </div>
  <div class="{{ styles.actions }}">
    {{{Button ref="submitBtn" text="Зарегистрироваться" type="submit"}}}
    {{{Link ref="loginLink" href="#" text="Войти"}}}
  </div>
</form>
